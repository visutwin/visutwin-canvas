{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "visutwin-canvas",
  "version-string": "0.1.0",
  "description": "C++ 3D engine targeting Apple Metal, derived from the PlayCanvas engine",
  "license": "Apache-2.0",
  "builtin-baseline": "b472291f295551b7127359ea38fdd2ca092f6f1b",
  "dependencies": [
    { "name": "spdlog",         "version>=": "1.17.0", "default-features": false, "features": ["tz-offset"] },
    { "name": "sdl3",           "version>=": "3.4.2", "features": ["vulkan"] },
    { "name": "stb"                                    },
    { "name": "ktx"                                    },
    { "name": "tinyobjloader"                         },
    { "name": "tinygltf"                              },
    { "name": "draco"                                 },
    { "name": "assimp"                                },
    { "name": "boost-core"                            },
    { "name": "imgui",          "features": ["sdl3-binding", { "name": "metal-binding", "platform": "osx" }, "docking-experimental"] },
    { "name": "implot"                               }
  ],
  "features": {
    "basisu-transcoder": {
      "description": "Use the standalone basisu KTX2 transcoder instead of libktx (-DVISUTWIN_KTX2_USE_LIBKTX=OFF). Incompatible with anything that also links libktx, such as cesium-native: the two bundle different copies of basis_universal and export the same symbols",
      "dependencies": [
        { "name": "basisu" }
      ]
    },
    "jolt": {
      "description": "Jolt Physics backend for the PhysicsWorld seam",
      "dependencies": [
        { "name": "joltphysics" }
      ]
    },
    "vulkan": {
      "description": "Vulkan rendering backend",
      "dependencies": [
        { "name": "imgui", "features": ["vulkan-binding"] },
        { "name": "vulkan-headers"           },
        { "name": "vulkan-memory-allocator"  },
        { "name": "vk-bootstrap"             },
        { "name": "shaderc"                  },
        { "name": "spirv-cross"              }
      ]
    }
  },
  "vcpkg-configuration": {
    "overlay-ports": ["./vcpkg-overlays/ports"]
  }
}
