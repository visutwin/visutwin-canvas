{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_BUILD_TYPE": "Debug",
        "VISUTWIN_BUILD_EXAMPLES": "OFF",
        "VCPKG_MANIFEST_FEATURES": "jolt"
      }
    },
    {
      "name": "release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "examples",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-examples",
      "cacheVariables": {
        "VISUTWIN_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "vulkan",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-vulkan",
      "cacheVariables": {
        "VISUTWIN_BACKEND_METAL": "OFF",
        "VISUTWIN_BACKEND_VULKAN": "ON",
        "VCPKG_MANIFEST_FEATURES": "vulkan;jolt"
      }
    },
    {
      "name": "sanitize",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "VISUTWIN_SANITIZE": "address;undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "vulkan",
      "configurePreset": "vulkan"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "exclude": {
          "label": "vulkan|golden"
        }
      }
    },
    {
      "name": "vulkan",
      "configurePreset": "vulkan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "exclude": {
          "label": "vulkan|golden"
        }
      }
    },
    {
      "name": "vulkan-smoke",
      "configurePreset": "vulkan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "vulkan"
        }
      }
    },
    {
      "name": "golden",
      "configurePreset": "examples",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "include": {
          "label": "golden"
        }
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "filter": {
        "exclude": {
          "label": "vulkan|golden"
        }
      }
    }
  ]
}
