@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Stb ships a find module rather than a config file, and assimp's own config
# also asks for it, so the module path has to be in place before ANY dependency
# is looked up. Search the consumer's prefixes and vcpkg's installed tree.
set(_visutwin_canvas_stb_roots ${CMAKE_PREFIX_PATH})
foreach(_installed IN ITEMS "${VCPKG_INSTALLED_DIR}" "${_VCPKG_INSTALLED_DIR}")
    if(_installed AND VCPKG_TARGET_TRIPLET)
        list(APPEND _visutwin_canvas_stb_roots "${_installed}/${VCPKG_TARGET_TRIPLET}")
    endif()
endforeach()
foreach(_prefix IN LISTS _visutwin_canvas_stb_roots)
    if(EXISTS "${_prefix}/share/stb/FindStb.cmake")
        list(PREPEND CMAKE_MODULE_PATH "${_prefix}/share/stb")
        break()
    endif()
endforeach()
unset(_visutwin_canvas_stb_roots)
find_dependency(Stb MODULE)

# The engine links these publicly, so a consumer needs them on its link line.
find_dependency(spdlog        CONFIG)
find_dependency(SDL3          CONFIG)
find_dependency(tinyobjloader CONFIG)
find_dependency(draco         CONFIG)
find_dependency(Boost         COMPONENTS core)
find_dependency(assimp        CONFIG)
find_dependency(imgui         CONFIG)
find_dependency(implot        CONFIG)

if(@VISUTWIN_KTX2_USE_LIBKTX@)
    find_dependency(Ktx CONFIG)
else()
    find_dependency(basisu CONFIG)
endif()

if(@VISUTWIN_PHYSICS_JOLT@)
    find_package(unofficial-joltphysics CONFIG QUIET)
    if(NOT TARGET unofficial::joltphysics::Jolt)
        find_dependency(Jolt CONFIG)
    endif()
endif()

if(@VISUTWIN_BACKEND_VULKAN@)
    find_dependency(VulkanHeaders CONFIG)
    find_dependency(Vulkan)
    find_dependency(VulkanMemoryAllocator CONFIG)
    find_dependency(vk-bootstrap CONFIG)
    if(@VISUTWIN_HAS_SHADERC@)
        find_dependency(unofficial-shaderc CONFIG)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VisuTwinCanvasTargets.cmake")

# Header-only dependencies the engine exposes in its public headers. They have no
# CMake package, so the paths are resolved here rather than baked into the export
# (an absolute build-tree path would not survive installation).
find_path(VISUTWIN_CANVAS_TINYGLTF_INCLUDE_DIR "tiny_gltf.h" REQUIRED)
find_path(VISUTWIN_CANVAS_NLOHMANN_JSON_INCLUDE_DIR "nlohmann/json.hpp" REQUIRED)
set_property(TARGET visutwin::canvas APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
    "${Stb_INCLUDE_DIR}"
    "${VISUTWIN_CANVAS_TINYGLTF_INCLUDE_DIR}"
    "${VISUTWIN_CANVAS_NLOHMANN_JSON_INCLUDE_DIR}")

# What this package was BUILT with. A consumer cannot change these after the
# fact -- they are compiled into the library -- so it should check the ones it
# depends on and fail loudly rather than silently getting the wrong engine.
set(VISUTWIN_CANVAS_SHARED @VISUTWIN_CANVAS_SHARED@)
set(VISUTWIN_CANVAS_BACKEND_METAL @VISUTWIN_BACKEND_METAL@)
set(VISUTWIN_CANVAS_BACKEND_VULKAN @VISUTWIN_BACKEND_VULKAN@)
set(VISUTWIN_CANVAS_PHYSICS_JOLT @VISUTWIN_PHYSICS_JOLT@)
set(VISUTWIN_CANVAS_KTX2_USE_LIBKTX @VISUTWIN_KTX2_USE_LIBKTX@)

# Shader chunks are loaded from the filesystem at runtime (see shaderChunks.cpp).
# The installed tree is baked into the library; this exposes it to consumers that
# want to copy or point at it themselves.
set_and_check(VISUTWIN_CANVAS_SHADER_DIR "@PACKAGE_VISUTWIN_CANVAS_INSTALL_SHADER_DIR@")

check_required_components(VisuTwinCanvas)
